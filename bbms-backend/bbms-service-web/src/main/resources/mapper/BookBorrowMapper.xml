<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xq.web.borrow.record.mapper.BookBorrowMapper">

  <!-- 批量更新借阅状态 -->
  <update id="batchUpdateStatus">
    UPDATE book_borrow
    SET borrow_status = #{status},
    actual_return_time = #{actualReturnTime},
    update_time = NOW()
    WHERE borrow_id IN
    <foreach collection="borrowIds" item="id" open="(" separator="," close=")">
      #{id}
    </foreach>
  </update>

</mapper>
